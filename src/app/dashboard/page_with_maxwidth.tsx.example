/**
 * Guia de tamanhos:
 * 
 * size="sm"   - 640px  - Formulários estreitos, modals
 * size="md"   - 768px  - Conteúdo text-heavy, artigos
 * size="lg"   - 1024px - Dashboards simples
 * size="xl"   - 1280px - Dashboards complexos (RECOMENDADO)
 * size="2xl"  - 1536px - Data tables largas
 * size="full" - 100%   - Sem limite (quando precisar)
 */
