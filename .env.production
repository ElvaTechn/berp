# ========================================
# Ambiente de Produção
# ========================================

# Database - PostgreSQL em produção
# Formato: postgresql://user:password@host:port/database
# Exemplo: postgresql://berp_user:senha123@db.example.com:5432/berp_prod
DATABASE_URL="postgresql://user:password@host:5432/berp_production"

# Node Environment
NODE_ENV="production"
UPSTASH_REDIS_REST_URL="https://genuine-squid-25904.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AmUwAAIgcDHjyeY6z1mjnM9HPEh6kndm7m5_UhUd0yA5Ex7HcmvACA"
# Prisma
PRISMA_PREVIEW_FEATURE_ENABLED=false

# Admin defaults para seed (mudar para produção)
DEFAULT_ADMIN_EMAIL="admin@empresa.co.mz"
DEFAULT_ADMIN_PASSWORD="GERE_UMA_SENHA_FORTE_E_UNICA"
DEFAULT_ADMIN_NAME="Administrador Sistema"

# Aplicação
NEXT_PUBLIC_API_URL="https://api.empresa.co.mz"

# JWT - MUDE PARA CHAVE FORTE
JWT_SECRET="MUDE_PARA_CHAVE_CRIPTOGRAFICA_FORTE"

# Rate Limiting (mais restritivo em produção)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=50

# Segurança adicional
SECURE_COOKIES=true
HTTPS_ONLY=true
CSRF_PROTECTION=true

# Logging
LOG_LEVEL="info"
