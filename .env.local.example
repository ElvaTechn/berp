# ================================================================
# BIZCONTROL 360 ERP - Environment Variables
# ================================================================
# Copie este arquivo para .env.local e ajuste as variáveis

# PWA Development
# Descomente para habilitar PWA em desenvolvimento local
# ENABLE_PWA_DEV=true

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET="your-secret-key-here"
JWT_EXPIRES_IN="7d"

# Redis (opcional)
REDIS_URL="redis://localhost:6379"

# Email (opcional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Analytics (opcional)
NEXT_PUBLIC_GA_ID=

# Sentry (opcional)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
