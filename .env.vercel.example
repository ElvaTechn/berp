# ================================================================
# VARIÁVEIS DE AMBIENTE PARA VERCEL
# ================================================================
# Configure estas variáveis no painel da Vercel em:
# Settings > Environment Variables

# ================================================================
# DATABASE (OBRIGATÓRIO)
# ================================================================
# Supabase PostgreSQL Connection String
# Formato: postgresql://postgres.[projeto]:[senha]@[host]:6543/postgres
DATABASE_URL="postgresql://postgres.xxxxx:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# ================================================================
# AUTHENTICATION (OBRIGATÓRIO)
# ================================================================
# JWT Secret - Use um valor forte e único
# Gerar: openssl rand -base64 64
JWT_SECRET="SEU_JWT_SECRET_FORTE_AQUI"

# NextAuth Secret - Use um valor forte e único
# Gerar: openssl rand -base64 64
NEXTAUTH_SECRET="SEU_NEXTAUTH_SECRET_FORTE_AQUI"

# NextAuth URL - URL da sua aplicação na Vercel
# Formato: https://seu-app.vercel.app
NEXTAUTH_URL="https://seu-app.vercel.app"

# ================================================================
# APPLICATION (OBRIGATÓRIO)
# ================================================================
# URL pública da aplicação
NEXT_PUBLIC_APP_URL="https://seu-app.vercel.app"

# ================================================================
# REDIS (OPCIONAL - Já configurado com Upstash)
# ================================================================
UPSTASH_REDIS_REST_URL="https://genuine-squid-25904.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AmUwAAIgcDHjyeY6z1mjnM9HPEh6kndm7m5_UhUd0yA5Ex7HcmvACA"

# ================================================================
# PWA (OPCIONAL)
# ================================================================
# Habilitar PWA em desenvolvimento (deixe desabilitado na Vercel)
# ENABLE_PWA_DEV=false

# ================================================================
# HEALTH CHECK (OPCIONAL)
# ================================================================
HEALTH_CHECK_API_KEY="SEU_HEALTH_CHECK_KEY"

# ================================================================
# ANALYTICS (OPCIONAL)
# ================================================================
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# SENTRY_DSN=https://...
# SENTRY_AUTH_TOKEN=...

# ================================================================
# EMAIL (OPCIONAL)
# ================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=sua-senha-de-app
